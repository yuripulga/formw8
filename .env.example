# Google AdSense Monetization (Optional)
# Both values are required to enable ads; otherwise a sponsorship invitation is shown.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"
# NEXT_PUBLIC_ADSENSE_SLOT_ID="1234567890"

# Affiliate & Referral Configuration (Optional)
# Links e cupons para monetização e parcerias de câmbio:
NEXT_PUBLIC_HUSKY_AFFILIATE_URL="https://app.husky.io/onboarding?ref=YOUR_REF_ID"
NEXT_PUBLIC_HUSKY_COUPON=""

NEXT_PUBLIC_HIGLOBE_AFFILIATE_URL="https://higlobe.com"
NEXT_PUBLIC_HIGLOBE_COUPON=""

NEXT_PUBLIC_WISE_AFFILIATE_URL="https://wise.com"
NEXT_PUBLIC_WISE_COUPON=""

NEXT_PUBLIC_NOMAD_AFFILIATE_URL="https://nomadglobal.com"
NEXT_PUBLIC_NOMAD_COUPON=""

# Contact (Optional)
# Public e-mail used for partnership / sponsorship links in the footer and ad slot.
NEXT_PUBLIC_CONTACT_EMAIL="info@quimera.biz"

# Pix donation key (Optional - defaults to the maintainer's random key)
# NEXT_PUBLIC_PIX_KEY=""

# Public site origin (Optional) - used for canonical URLs, sitemap, robots and OpenGraph.
NEXT_PUBLIC_SITE_URL="https://formw8.quimera.biz"
