{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/w8ben",
        "destination": "/w8ben-pessoa-fisica",
        "type": 301
      },
      {
        "source": "/w8bene",
        "destination": "/w8bene-pessoa-juridica",
        "type": 301
      },
      {
        "source": "/deel",
        "destination": "/plataformas/deel",
        "type": 301
      },
      {
        "source": "/rippling",
        "destination": "/plataformas/rippling",
        "type": 301
      },
      {
        "source": "/upwork",
        "destination": "/plataformas/upwork",
        "type": 301
      },
      {
        "source": "/remote",
        "destination": "/plataformas/remote",
        "type": 301
      },
      {
        "source": "/google-adsense",
        "destination": "/plataformas/google-adsense",
        "type": 301
      },
      {
        "source": "/apple-developer",
        "destination": "/plataformas/apple-developer",
        "type": 301
      },
      {
        "source": "/steam",
        "destination": "/plataformas/steam",
        "type": 301
      },
      {
        "source": "/github-sponsors",
        "destination": "/plataformas/github-sponsors",
        "type": 301
      },
      {
        "source": "/stripe",
        "destination": "/plataformas/stripe",
        "type": 301
      },
      {
        "source": "/payoneer",
        "destination": "/plataformas/payoneer",
        "type": 301
      },
      {
        "source": "/fiverr",
        "destination": "/plataformas/fiverr",
        "type": 301
      },
      {
        "source": "/turing",
        "destination": "/plataformas/turing",
        "type": 301
      },
      {
        "source": "/toptal",
        "destination": "/plataformas/toptal",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.adtrafficquality.google https://www.googletagservices.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://brasilapi.com.br https://minhareceita.org https://publica.cnpj.ws https://viacep.com.br https://pagead2.googlesyndication.com https://*.adtrafficquality.google https://*.google.com; frame-src 'self' blob: https://googleads.g.doubleclick.net https://*.googlesyndication.com https://tpc.googlesyndication.com https://*.adtrafficquality.google https://www.google.com; object-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests;"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=63072000; includeSubDomains; preload"
          }
        ]
      },
      {
        "source": "_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "forms/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      }
    ]
  }
}
